# Google Sheets / Excel Live Database URL
# Provide the link to your Google Sheet (public/shared link or export link)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit?usp=sharing
# Or direct export: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/export?format=xlsx
GOOGLE_SHEET_URL=""

# LLM Configuration
# If LLM_API_KEY is not provided, the app uses a built-in semantic matching evaluator fallback.
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
# LLM_BASE_URL="https://api.openai.com/v1"
